  2. "Toronto"                          "MISSISSAUGA"         0.14  "approx"
  3. "Toronto"                          "OAKVILLE_MILTON"     0.08  "approx"
  4. "Vancouver"                        "GREATER_VANCOUVER"   0.88  "approx"
  5. "Vancouver"                        "FRASER_VALLEY"       0.12  "approx"
  6. "Kitchener - Cambridge - Waterloo" "KITCHENER_WATERLOO"  0.72  "approx"
  7. "Kitchener - Cambridge - Waterloo" "CAMBRIDGE"           0.28  "approx"
  8. "Barrie"                           "BARRIE_AND_DISTRICT" 0.82  "approx"
  9. "Barrie"                           "SIMCOE_AND_DISTRICT" 0.18  "approx"
 10. "Toronto"                          "GREATER_TORONTO"     0.3333 "equal"
