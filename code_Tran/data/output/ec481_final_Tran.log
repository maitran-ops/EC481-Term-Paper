. * -------------------------- Single-board baseline (for comparison) ---------
. use "$clean/core_affordability_panel_expanded_Tran.dta", clear

. xtset market_id year

Panel variable: market_id (strongly balanced)
 Time variable: year, 2016 to 2023
         Delta: 1 unit

. quietly xtreg affordability_gap c.qual_rate#c.pre_exposure_z i.year, ///
>     fe vce(cluster cluster_id)

. post `rh' ("single_board") (_b[c.qual_rate#c.pre_exposure_z]) ///
>     (_se[c.qual_rate#c.pre_exposure_z]) (2*ttail(e(df_r), abs(_b[c.qual_rate#c.pre_exposure
> _z]/_se[c.qual_rate#c.pre_exposure_z]))) ///
>     (e(N)) (e(N_clust))

. 
. * -------------------------- Composite schemes -------------------------------
. foreach sch in approx equal pop_share {
  2. 
.     * Build the composite HPI for this scheme
.     preserve
  3.         use `allweights', clear
  4.         keep if scheme == "`sch'"
  5.         drop scheme
  6.         tempfile wsch
  7.         save `wsch', replace
  8.     restore
  9. 
.     preserve
 10.         use "$clean/hpi_annual_clean_Tran.dta", clear
 11.         replace crea_market = strtrim(itrim(crea_market))
 12.         merge m:1 crea_market using `wsch'
 13.         * _merge==2 => a weight row whose board has no HPI series (shouldn't happen
.         * for these 9 boards, but check defensively)
.         capture assert _merge != 2
 14.         if _rc {
 15.             display as error "Weight scheme `sch': a board in the weight file has no HPI
>  series."
 16.             list crea_market if _merge == 2
 17.         }
 18.         keep if _merge == 3
 19.         drop _merge
 20.         gen weighted_price = weight * benchmark_price
 21.         collapse (sum) benchmark_price_composite = weighted_price, by(cma_name year)
 22.         tempfile compsch
 23.         save `compsch', replace
 24.         * Also cache persistently so 11_paper_outputs.do (outreg2 table 3) can
.         * reuse this exact composite series without rebuilding it.
.         save "$clean/hpi_composite_`sch'_Tran.dta", replace
 25.     restore
 26. 
.     * Merge composite onto the single-board expanded panel, overwrite the 4 CMAs
.     use "$clean/core_affordability_panel_expanded_Tran.dta", clear
 27.     merge m:1 cma_name year using `compsch'
 28.     replace benchmark_price = benchmark_price_composite if !missing(benchmark_price_comp
> osite)
 29.     drop _merge benchmark_price_composite
 30. 
.     * Recompute the affordability gap with the composite-adjusted price
.     replace affordability_gap = ln(benchmark_price) - ln(max_qualified_price)
 31. 
.     * Re-standardize pre-2022 exposure under the composite (small mechanical
.     * change for the 4 affected CMAs' pre-period P/I ratio)
.     replace price_income_ratio = benchmark_price / median_income
 32.     capture drop pre_exposure_raw
 33.     capture drop pre_exposure_z
 34.     capture drop tag_market
 35.     egen pre_exposure_raw = mean(cond(inrange(year,2016,2021), price_income_ratio, .)), 
> by(market_id)
 36.     egen tag_market = tag(market_id)
 37.     quietly summ pre_exposure_raw if tag_market == 1
 38.     gen pre_exposure_z = (pre_exposure_raw - r(mean)) / r(sd)
 39.     drop tag_market
 40. 
.     xtset market_id year
 41.     quietly xtreg affordability_gap c.qual_rate#c.pre_exposure_z i.year, ///
>         fe vce(cluster cluster_id)
 42.     post `rh' ("`sch'") (_b[c.qual_rate#c.pre_exposure_z]) ///
>         (_se[c.qual_rate#c.pre_exposure_z]) (2*ttail(e(df_r), abs(_b[c.qual_rate#c.pre_expo
> sure_z]/_se[c.qual_rate#c.pre_exposure_z]))) ///
>         (e(N)) (e(N_clust))
 43. }
